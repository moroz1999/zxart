{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/zx-badge/**",
              "components/zx-button/**",
              "components/zx-medal/**",
              "components/zx-stars/**",
              "geo/**",
              "stats/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:PT Sans|Roboto))/i]",
        "message": "Font not provided by the design system. Available: PT Sans, Roboto."
      },
      {
        "selector": "JSXOpeningElement[name.name='ZxBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|key|ref|className|style|children)$/]",
        "message": "<ZxBadge> doesn't accept that prop. Declared props: children, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='ZxBadge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary)$/]",
        "message": "<ZxBadge> variant must be one of 'primary' | 'secondary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ZxButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|variant|shape|disabled|href|onClick|ariaLabel|style|key|ref|className|style|children)$/]",
        "message": "<ZxButton> doesn't accept that prop. Declared props: children, size, variant, shape, disabled, href, onClick, ariaLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ZxButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xs|sm|md)$/]",
        "message": "<ZxButton> size must be one of 'xs' | 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ZxButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|outlined|transparent)$/]",
        "message": "<ZxButton> variant must be one of 'primary' | 'secondary' | 'outlined' | 'transparent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ZxButton'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:square|round)$/]",
        "message": "<ZxButton> shape must be one of 'square' | 'round'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ZxMedal'] > JSXAttribute > JSXIdentifier[name!=/^(?:place|key|ref|className|style|children)$/]",
        "message": "<ZxMedal> doesn't accept that prop. Declared props: place."
      },
      {
        "selector": "JSXOpeningElement[name.name='ZxStars'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|count|key|ref|className|style|children)$/]",
        "message": "<ZxStars> doesn't accept that prop. Declared props: value, count."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
